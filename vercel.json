{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/workshops",
      "destination": "/discovery-call",
      "permanent": true
    },
    {
      "source": "/application",
      "destination": "/discovery-call",
      "permanent": true
    }
  ]
}
